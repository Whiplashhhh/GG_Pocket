# /srv/ggpocket/.env on the club's server (DECISIONS D-126), written by
# scripts/server/setup-shared.sh with fresh secrets, mode 600, never in git.
GG_ENVIRONMENT=prod
GG_SPRING_PROFILE=prod
# Shared reverse proxy: the web container joins this external Docker network under this name, and
# the proxy forwards the club's address to GG_PROXY_ALIAS:8080 (deploy/compose.proxy.yml).
GG_PROXY_NETWORK=web
GG_PROXY_ALIAS=ggpocket
# Unused here (no published port, see compose.proxy.yml), but compose.yml requires a value.
GG_WEB_PORT=8180
# The API's database role (not superuser).
GG_DB_USER=ggpocket
# Long random value: openssl rand -base64 33
GG_DB_PASSWORD=
# Password of the PostgreSQL superuser "postgres", used by backups and restores only.
GG_DB_ADMIN_PASSWORD=
# Nightly dumps (database and photos) where the server's own nightly backup picks them up.
GG_BACKUP_HOST_DIR=/srv/ggpocket/data/backups
GG_API_MEMORY=768m
GG_DB_MEMORY=512m
# Optional: another registry or owner for the images (default ghcr.io/whiplashhhh).
# GG_REGISTRY=ghcr.io/whiplashhhh
