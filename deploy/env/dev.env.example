# /opt/gg-pocket/dev/.env (written by scripts/server/bootstrap.sh, mode 600, never in git).
GG_ENVIRONMENT=dev
GG_SPRING_PROFILE=dev
GG_WEB_PORT=8181
# The API's database role (not superuser).
GG_DB_USER=ggpocket
# Long random value: openssl rand -base64 33
GG_DB_PASSWORD=
# Password of the PostgreSQL superuser "postgres", used by backups and restores only.
GG_DB_ADMIN_PASSWORD=
# Password of the demo accounts (admin, direction, ouvreur, grimpeur), shared with the testers.
GG_SEED_PASSWORD=
GG_API_MEMORY=640m
GG_DB_MEMORY=384m
