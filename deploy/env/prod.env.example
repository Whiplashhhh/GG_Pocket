# /opt/gg-pocket/prod/.env (written by scripts/server/bootstrap.sh, mode 600, never in git).
GG_ENVIRONMENT=prod
GG_SPRING_PROFILE=prod
# Loopback port the edge proxy forwards pocket.<domain> to (deploy/edge/Caddyfile).
GG_WEB_PORT=8180
# The API's database role (not superuser).
GG_DB_USER=ggpocket
# Long random value: openssl rand -base64 33
GG_DB_PASSWORD=
# Password of the PostgreSQL superuser "postgres", used by backups and restores only.
GG_DB_ADMIN_PASSWORD=
GG_BACKUP_HOST_DIR=/opt/gg-pocket/prod/backups
GG_API_MEMORY=768m
GG_DB_MEMORY=512m
# Optional: another registry or owner for the images (default ghcr.io/whiplashhhh).
# GG_REGISTRY=ghcr.io/whiplashhhh
