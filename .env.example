# GG Pocket: environment variables read by the backend.
# Copy to .env for your deployment; real .env files are ignored by git (never commit secrets).
# Local development needs none of these: defaults match deploy/compose.local.yml.

# Where this instance runs: local | dev | prod. Written in the database at first start;
# the backend refuses to start against a database marked for another environment.
GG_ENVIRONMENT=local

# Spring profile: "dev" (local machine and dev environment) or "prod".
SPRING_PROFILES_ACTIVE=dev

# Database (required in prod, optional with the dev profile).
GG_DB_URL=jdbc:postgresql://localhost:5432/ggpocket
GG_DB_USER=ggpocket
GG_DB_PASSWORD=change-me

# Build origin shown by /api/v1/meta and the dev banner. Set by the Docker images (phase 2).
GG_GIT_COMMIT=unknown
GG_GIT_BRANCH=unknown
