{
  "name": "gg-pocket-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:stack": "playwright test --config playwright.stack.config.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "api:types": "openapi-typescript src/api/openapi.json --output src/api/schema.d.ts && prettier --write src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@tanstack/vue-query": "5.104.3",
    "@vueuse/core": "15.0.0",
    "lucide-vue-next": "1.0.0",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.15",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "11.2.6",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
